        },
        {
          "text": "I finished the quest.",
          "next": "quest_completed",
          "showIfQuestStatus": {
            "questId": "clear_dungeon",
            "status": "Completed"
          }
        },
        {
          "text": "Goodbye.",
          "next": "end"
        }
      ]
    },

    "who": {
